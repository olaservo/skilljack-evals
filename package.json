{
  "name": "@skilljack/evals",
  "version": "1.2.1",
  "type": "module",
  "description": "CLI for evaluating AI agent skill discoverability, adherence, and output quality. Runs as standalone CLI or GitHub Action.",
  "author": "Ola Hungerford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/olaservo/skilljack-evals.git"
  },
  "homepage": "https://github.com/olaservo/skilljack-evals",
  "keywords": [
    "agent-skills",
    "evaluation",
    "llm",
    "testing",
    "skill-discovery",
    "claude",
    "github-action"
  ],
  "bin": {
    "skilljack-evals": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:action": "npm run build && esbuild dist/action/index.js --bundle --platform=node --target=node20 --format=cjs --outfile=action/dist/index.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@actions/core": "^1.10.0",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "action"
  ]
}
